---
// Clean inline SVGs for zero dependency issues and pure static HTML output
---

<section id="contact" class="py-[var(--space-section-y)] border-t border-[var(--border-subtle)] bg-[var(--bg-app)] relative" aria-labelledby="contact-heading">
  <div class="max-w-[var(--container-max-w)] mx-auto px-[var(--space-gutter)]">
    
    <div class="max-w-3xl mx-auto text-center space-y-4 mb-10">
      <div class="inline-flex items-center gap-2 text-[var(--accent)] font-mono text-[var(--text-xs)] uppercase tracking-wider">
        <span class="w-2 h-2 bg-[var(--accent)] rounded-full"></span>
        <span>07 // Direct Dispatch</span>
      </div>
      <h2 id="contact-heading" class="text-[var(--text-xl)] font-serif font-medium tracking-tight text-[var(--text-primary)]">
        Initiate Technical Collaboration
      </h2>
      <p class="text-[var(--text-sm)] text-[var(--text-secondary)] leading-relaxed">
        Whether you are scaling an on-premise AI model pipeline, building custom Odoo ERP architecture, or need a full-stack engineer who understands low-level constraints — my inbox is open.
      </p>
    </div>

    <!-- Contact Channels Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-4xl mx-auto">
      
      <!-- Email Card (Primary) -->
      <a
        href="mailto:harshthanki203@gmail.com"
        class="touch-target p-5 border border-[var(--accent)] bg-[var(--accent-subtle)] text-[var(--text-primary)] hover:bg-[var(--accent)] hover:text-[var(--accent-text)] rounded-[var(--radius-sm)] transition-all flex flex-col justify-between space-y-4 group"
      >
        <div class="flex items-center justify-between">
          <svg class="w-5 h-5 text-[var(--accent)] group-hover:text-[var(--accent-text)] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <span class="font-mono text-[10px] uppercase font-bold tracking-wider">Direct Mail</span>
        </div>
        <div>
          <div class="font-mono text-[var(--text-xs)] font-medium truncate">harshthanki203@gmail.com</div>
          <div class="text-[10px] opacity-75 mt-0.5">&lt;24h response SLA</div>
        </div>
      </a>

      <!-- GitHub -->
      <a
        href="https://github.com/harshthanki-codes"
        target="_blank"
        rel="noopener noreferrer"
        class="touch-target p-5 border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-primary)] hover:border-[var(--accent)] hover:text-[var(--accent)] rounded-[var(--radius-sm)] transition-all flex flex-col justify-between space-y-4 group"
      >
        <div class="flex items-center justify-between">
          <svg class="w-5 h-5 text-[var(--text-secondary)] group-hover:text-[var(--accent)] transition-colors" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <svg class="w-3.5 h-3.5 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </div>
        <div>
          <div class="font-mono text-[var(--text-xs)] font-medium">GitHub</div>
          <div class="text-[10px] text-[var(--text-tertiary)] mt-0.5">Code repositories &amp; evals</div>
        </div>
      </a>

      <!-- LinkedIn -->
      <a
        href="https://www.linkedin.com/in/harshthanki"
        target="_blank"
        rel="noopener noreferrer"
        class="touch-target p-5 border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-primary)] hover:border-[var(--accent)] hover:text-[var(--accent)] rounded-[var(--radius-sm)] transition-all flex flex-col justify-between space-y-4 group"
      >
        <div class="flex items-center justify-between">
          <svg class="w-5 h-5 text-[var(--text-secondary)] group-hover:text-[var(--accent)] transition-colors" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
          </svg>
          <svg class="w-3.5 h-3.5 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </div>
        <div>
          <div class="font-mono text-[var(--text-xs)] font-medium">LinkedIn</div>
          <div class="text-[10px] text-[var(--text-tertiary)] mt-0.5">Professional network</div>
        </div>
      </a>

      <!-- Freelancer -->
      <a
        href="https://www.freelancer.com/u/harshthanki203"
        target="_blank"
        rel="noopener noreferrer"
        class="touch-target p-5 border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-primary)] hover:border-[var(--accent)] hover:text-[var(--accent)] rounded-[var(--radius-sm)] transition-all flex flex-col justify-between space-y-4 group"
      >
        <div class="flex items-center justify-between">
          <svg class="w-5 h-5 text-[var(--text-secondary)] group-hover:text-[var(--accent)] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
          </svg>
          <svg class="w-3.5 h-3.5 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </div>
        <div>
          <div class="font-mono text-[var(--text-xs)] font-medium">Freelancer</div>
          <div class="text-[10px] text-[var(--text-tertiary)] mt-0.5">Contract engagements</div>
        </div>
      </a>

    </div>

    <!-- PGP / Security Note -->
    <div class="mt-12 p-4 border border-[var(--border-subtle)] bg-[var(--bg-surface)] max-w-xl mx-auto text-center font-mono text-[11px] text-[var(--text-tertiary)] rounded-[var(--radius-sm)]">
      <span class="text-[var(--accent)]">⚡ STATUS:</span> Actively accepting freelance, consulting, and select high-ownership engineering roles.
    </div>

  </div>
</section>
