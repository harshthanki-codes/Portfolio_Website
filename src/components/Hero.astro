---
import { HeroFallbackDiagram } from './islands/HeroFallbackDiagram';
import { HeroInteractiveView } from './islands/HeroInteractiveView';
---

<section id="hero" class="relative pt-4 pb-12 sm:pt-10 sm:pb-16 lg:pt-14 lg:pb-20 overflow-hidden" aria-labelledby="hero-heading">
  <div class="max-w-[var(--container-max-w)] mx-auto px-[var(--space-gutter)] relative z-10">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Column: High-Impact Technical Narrative & Executive Presence -->
      <div class="lg:col-span-6 space-y-4 sm:space-y-6">
        
        <!-- Executive Identity Card with Portrait & Status Pill -->
        <div class="flex items-center gap-3 p-2 sm:p-2.5 pr-4 sm:pr-5 rounded-2xl sm:rounded-full bg-[var(--bg-surface-raised)] border border-[var(--border-subtle)] shadow-sm max-w-full sm:max-w-fit hover:border-[var(--accent-border)] transition-all">
          <div class="relative shrink-0">
            <div class="w-12 h-12 sm:w-16 sm:h-16 rounded-full overflow-hidden ring-2 ring-[var(--accent)] ring-offset-2 ring-offset-[#08090c] shadow-[0_0_15px_var(--accent-glow)] bg-neutral-900">
              <img 
                src="/Portfolio_Website/images/harsh-thanki.png" 
                alt="Harsh Thanki — AI Systems Architect & Backend Engineer" 
                class="w-full h-full object-cover object-top"
                width="64" 
                height="64" 
                loading="eager" 
                fetchpriority="high"
                onerror="this.onerror=null; this.src='/Portfolio_Website/images/harsh-thanki.webp';"
              />
            </div>
            <span class="absolute bottom-0 right-0 flex h-3 w-3 items-center justify-center rounded-full bg-[#08090c]">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--status-complete)] opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-[var(--status-complete)]"></span>
              </span>
            </span>
          </div>

          <div class="space-y-0.5 min-w-0 flex-1">
            <div class="flex items-center gap-2">
              <span class="font-mono font-bold text-xs text-[var(--text-primary)] tracking-wide">HARSH THANKI</span>
              <span class="text-[9px] font-mono px-2 py-0.5 rounded-full bg-[var(--accent-subtle)] text-[var(--accent)] border border-[var(--accent-border)] font-semibold">AVAILABLE Q4</span>
            </div>
            <div class="text-[var(--text-secondary)] font-mono text-[11px] leading-tight font-medium truncate">
              AI Systems Architect &middot; Python Backend &middot; ERP-CRM
            </div>
            <div class="text-[var(--text-tertiary)] font-mono text-[10px] flex items-center gap-1.5 flex-wrap">
              <span>Ahmedabad, India</span>
              <span>&middot;</span>
              <span>MCA &middot; Minor in AI/ML (IIT Mandi)</span>
            </div>
          </div>
        </div>

        <!-- Headline with Radiant Orange Gradient -->
        <h1 id="hero-heading" class="text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-serif font-normal tracking-tight text-[var(--text-primary)] leading-[1.12]">
          Architecting <span class="gradient-text-solar font-serif italic">custom AI systems</span>, enterprise pipelines &amp; software solutions.
        </h1>

        <!-- Narrative Paragraph -->
        <p class="text-xs sm:text-sm md:text-base text-[var(--text-secondary)] leading-relaxed max-w-xl font-sans">
          I build <strong class="text-[var(--text-primary)] font-semibold">custom LLM automation pipelines</strong>, <strong class="text-[var(--text-primary)] font-semibold">mission-critical ERP &amp; CRM architectures</strong>, and <strong class="text-[var(--text-primary)] font-semibold">resilient Python backend systems</strong>. Engineered for founders, enterprise clients, and tier-1 teams requiring measurable ROI, zero data-leakage, and airgapped reliability.
        </p>

        <!-- Interactive Persona-Tailored Metrics & Value Propositions -->
        <div class="pt-1">
          <HeroInteractiveView client:load />
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 pt-2">
          <a 
            href="#solutions" 
            class="touch-target px-5 py-3 rounded-full bg-[var(--accent-gradient)] text-white font-mono text-xs font-bold shadow-[0_4px_20px_var(--accent-glow)] hover:shadow-[0_8px_30px_var(--accent-glow)] transition-all flex items-center justify-center gap-2 text-center active:scale-95"
          >
            <span>Explore 4 Client Solutions &rarr;</span>
          </a>

          <a 
            href="#projects" 
            class="touch-target px-5 py-3 rounded-full border border-[var(--border-strong)] bg-[var(--bg-surface)] text-[var(--text-primary)] font-mono text-xs font-medium hover:border-[var(--accent)] hover:text-[var(--accent)] transition-all flex items-center justify-center gap-1.5 text-center"
          >
            <span>7 Architecture Case Studies &darr;</span>
          </a>

          <a 
            href="#scoper" 
            class="touch-target px-4 py-3 rounded-full bg-[var(--bg-surface-raised)] border border-[var(--border-subtle)] text-[var(--text-secondary)] font-mono text-xs hover:text-[var(--accent)] hover:border-[var(--accent)] transition-all text-center"
          >
            <span>Scope Project</span>
          </a>
        </div>

      </div>

      <!-- Right Column: Signature Interactive Element (Live 7-Tier Fallback Diagram) -->
      <div class="lg:col-span-6 mt-4 lg:mt-0">
        <div class="relative">
          <div class="absolute -inset-1 bg-gradient-to-r from-orange-500/20 to-amber-500/20 rounded-[var(--radius-lg)] blur-xl opacity-60 pointer-events-none"></div>
          <div class="relative">
            <HeroFallbackDiagram client:load />
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
