---
import { HeroFallbackDiagram } from './islands/HeroFallbackDiagram';
---

<section id="hero" class="relative pt-12 pb-16 lg:pt-20 lg:pb-24 overflow-hidden" aria-labelledby="hero-heading">
  <div class="max-w-[var(--container-max-w)] mx-auto px-[var(--space-gutter)]">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Column: Technical Narrative & Positioning -->
      <div class="lg:col-span-6 space-y-6">
        
        <!-- Status Indicator Pill -->
        <div class="inline-flex items-center gap-2 px-2.5 py-1 border border-[var(--border-subtle)] bg-[var(--bg-surface)] font-mono text-[var(--text-xs)] text-[var(--text-secondary)] rounded-[var(--radius-sm)]">
          <span className="w-2 h-2 rounded-full bg-[var(--status-complete)] animate-pulse"></span>
          <span>Available for High-Impact Applied AI &amp; Backend Engineering</span>
        </div>

        <!-- Display Headline -->
        <h1 id="hero-heading" class="text-[var(--text-2xl)] font-serif font-normal tracking-tight text-[var(--text-primary)] leading-[1.1]">
          Architecting <em class="italic text-[var(--accent)] font-serif">resilient AI systems</em> &amp; production backends.
        </h1>

        <!-- High-Signal Narrative Paragraph -->
        <p class="text-[var(--text-md)] text-[var(--text-secondary)] leading-relaxed max-w-xl">
          I specialize in <strong>on-premise LLM fine-tuning</strong>, <strong>multi-tier failover pipelines</strong>, and <strong>high-throughput ERP architectures</strong>. Proven record deploying local open-weights intelligence, zero-cost automated ingestion, and tamper-proof security systems.
        </p>

        <!-- System Credentials Metric Strip -->
        <div class="grid grid-cols-3 gap-3 py-2 border-y border-[var(--border-subtle)] font-mono text-[var(--text-xs)]">
          <div>
            <div class="text-[var(--text-tertiary)] text-[10px] uppercase">Fine-Tuned Eval</div>
            <div class="text-[var(--text-primary)] font-bold text-[var(--text-sm)] mt-0.5">8.7 / 10</div>
            <div class="text-[10px] text-[var(--accent)]">vs Sonnet 5</div>
          </div>
          <div>
            <div class="text-[var(--text-tertiary)] text-[10px] uppercase">Failover Resilience</div>
            <div class="text-[var(--text-primary)] font-bold text-[var(--text-sm)] mt-0.5">7-Tier Chain</div>
            <div class="text-[10px] text-[var(--status-complete)]">0% Order Loss</div>
          </div>
          <div>
            <div class="text-[var(--text-tertiary)] text-[10px] uppercase">Deployment Scale</div>
            <div class="text-[var(--text-primary)] font-bold text-[var(--text-sm)] mt-0.5">35+ Nodes</div>
            <div class="text-[10px] text-[var(--text-secondary)]">Zero-License</div>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a 
            href="#projects" 
            class="touch-target px-5 py-2.5 bg-[var(--accent)] text-[var(--accent-text)] font-mono text-[var(--text-xs)] font-medium hover:bg-[var(--accent-hover)] transition-all shadow-xs flex items-center gap-2"
          >
            <span>Explore 7 Case Studies ↓</span>
          </a>
          <a 
            href="https://github.com/harshthanki-codes" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="touch-target px-5 py-2.5 border border-[var(--border-strong)] bg-[var(--bg-surface)] text-[var(--text-primary)] font-mono text-[var(--text-xs)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-all flex items-center gap-1.5"
          >
            <span>github.com/harshthanki-codes ↗</span>
          </a>
        </div>

      </div>

      <!-- Right Column: Signature Interactive Element (Live 7-Tier Fallback Diagram) -->
      <div class="lg:col-span-6">
        <HeroFallbackDiagram client:load />
      </div>

    </div>

  </div>
</section>
