---
import { HeroFallbackDiagram } from './islands/HeroFallbackDiagram';
---

<section id="hero" class="relative pt-10 pb-16 lg:pt-16 lg:pb-24 overflow-hidden solar-glow-bg" aria-labelledby="hero-heading">
  <div class="max-w-[var(--container-max-w)] mx-auto px-[var(--space-gutter)] relative z-10">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Column: High-Impact Technical Narrative & Executive Presence -->
      <div class="lg:col-span-6 space-y-6">
        
        <!-- Executive Identity Card with Circle Portrait & Status Pill -->
        <div class="flex items-center gap-4 p-2 sm:p-2.5 pr-5 rounded-full bg-[var(--bg-surface-raised)] border border-[var(--border-subtle)] shadow-sm max-w-fit hover:border-[var(--accent-border)] transition-all">
          <div class="relative shrink-0">
            <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full overflow-hidden ring-2 ring-[var(--accent)] ring-offset-2 ring-offset-[var(--bg-app)] shadow-[0_0_20px_var(--accent-glow)] bg-neutral-900">
              <img 
                src="/Portfolio_Website/images/harsh-thanki.png" 
                alt="Harsh Thanki — Python Developer & AI/ML Engineer" 
                class="w-full h-full object-cover object-top"
                width="64" 
                height="64" 
                loading="eager"
                fetchpriority="high"
              />
            </div>
            <span class="absolute bottom-0 right-0 flex h-3.5 w-3.5 items-center justify-center rounded-full bg-[var(--bg-app)]">
              <span class="relative flex h-2.5 w-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--status-complete)] opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[var(--status-complete)]"></span>
              </span>
            </span>
          </div>

          <div class="space-y-1 min-w-0">
            <div class="flex items-center gap-2">
              <span class="font-mono font-bold text-[var(--text-xs)] text-[var(--text-primary)] tracking-wide">HARSH THANKI</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-[var(--accent-subtle)] text-[var(--accent)] border border-[var(--accent-border)] font-semibold">ONLINE</span>
            </div>
            <div class="text-[var(--text-secondary)] font-mono text-[11px] leading-tight truncate font-medium">
              Python Developer &middot; AI/ML &amp; Enterprise ERP
            </div>
            <div class="text-[var(--text-tertiary)] font-mono text-[10px] flex items-center gap-1.5">
              <span>Ahmedabad, India</span>
              <span>&middot;</span>
              <span>MCA &middot; Minor in AI/ML (IIT Mandi)</span>
            </div>
          </div>
        </div>

        <!-- Headline with Radiant Orange Gradient -->
        <h1 id="hero-heading" class="text-[var(--text-2xl)] font-serif font-normal tracking-tight text-[var(--text-primary)] leading-[1.08]">
          Building <span class="gradient-text-solar font-serif italic">intelligent backend systems</span> &amp; AI solutions.
        </h1>

        <!-- Narrative Paragraph -->
        <p class="text-[var(--text-md)] text-[var(--text-secondary)] leading-relaxed max-w-xl font-sans">
          I build <strong class="text-[var(--text-primary)] font-semibold">custom LLM automation pipelines</strong>, <strong class="text-[var(--text-primary)] font-semibold">scalable enterprise operations architectures</strong>, and <strong class="text-[var(--text-primary)] font-semibold">resilient Python backend services</strong>. Focused on solving mission-critical business problems and delivering long-term client value.
        </p>

        <!-- System Metric Cards (Glow Strip) -->
        <div class="grid grid-cols-3 gap-3 py-3 border-y border-[var(--border-subtle)] font-mono text-[var(--text-xs)]">
          <div class="p-2.5 rounded-[var(--radius-sm)] bg-[var(--bg-surface-raised)] border border-[var(--border-subtle)] hover:border-[var(--accent-border)] transition-colors">
            <div class="text-[var(--text-tertiary)] text-[10px] uppercase tracking-wider">Fine-Tuned Eval</div>
            <div class="text-[var(--text-primary)] font-bold text-[var(--text-base)] mt-0.5">8.7 / 10</div>
            <div class="text-[10px] text-[var(--accent)] font-medium">vs Frontier Benchmark</div>
          </div>

          <div class="p-2.5 rounded-[var(--radius-sm)] bg-[var(--bg-surface-raised)] border border-[var(--border-subtle)] hover:border-[var(--accent-border)] transition-colors">
            <div class="text-[var(--text-tertiary)] text-[10px] uppercase tracking-wider">Failover Resilience</div>
            <div class="text-[var(--text-primary)] font-bold text-[var(--text-base)] mt-0.5">7-Tier Mesh</div>
            <div class="text-[10px] text-[var(--status-complete)] font-medium">0% Order Loss</div>
          </div>

          <div class="p-2.5 rounded-[var(--radius-sm)] bg-[var(--bg-surface-raised)] border border-[var(--border-subtle)] hover:border-[var(--accent-border)] transition-colors">
            <div class="text-[var(--text-tertiary)] text-[10px] uppercase tracking-wider">Endpoint Scale</div>
            <div class="text-[var(--text-primary)] font-bold text-[var(--text-base)] mt-0.5">35+ Nodes</div>
            <div class="text-[10px] text-[var(--text-secondary)] font-medium">Fails-Closed DNS</div>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a 
            href="#projects" 
            class="touch-target px-5 py-3 rounded-[var(--radius-md)] bg-[var(--accent-gradient)] text-[var(--accent-text)] font-mono text-[var(--text-xs)] font-bold shadow-[0_4px_20px_var(--accent-glow)] hover:shadow-[0_8px_30px_var(--accent-glow)] transition-all transform hover:-translate-y-0.5 active:translate-y-0 flex items-center gap-2"
          >
            <span>Explore 7 Case Studies &darr;</span>
          </a>

          <a 
            href="https://github.com/harshthanki-codes" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="touch-target px-5 py-3 rounded-[var(--radius-md)] border border-[var(--border-strong)] bg-[var(--bg-surface)] text-[var(--text-primary)] font-mono text-[var(--text-xs)] font-medium hover:border-[var(--accent)] hover:text-[var(--accent)] transition-all shadow-xs flex items-center gap-1.5"
          >
            <span>github.com/harshthanki-codes &nearr;</span>
          </a>
        </div>

      </div>

      <!-- Right Column: Signature Interactive Element (Live 7-Tier Fallback Diagram) -->
      <div class="lg:col-span-6">
        <div class="relative">
          <div class="absolute -inset-1 bg-gradient-to-r from-orange-500/20 to-amber-500/20 rounded-[var(--radius-lg)] blur-xl opacity-60 pointer-events-none"></div>
          <div class="relative">
            <HeroFallbackDiagram client:load />
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
