---
const PRINCIPLES = [
  {
    title: 'Zero Marginal Token Cost',
    metric: '$0.00 / Token Overhead',
    body: 'Cloud APIs are great for prototyping, but enterprise unit economics demand on-premise open-weights intelligence. Fine-tuning models on domain datasets turns recurring expenses into an owned high-margin asset.'
  },
  {
    title: 'Fault-Tolerant by Architecture',
    metric: '7-Tier Failover Mesh',
    body: 'Single-provider LLM pipelines fail in production. Whether it is an unexpected HTTP 429 rate limit or an upstream outage, systems must gracefully degrade across multi-tier failovers down to deterministic cached fallbacks.'
  },
  {
    title: 'Zero UI-Blocking & Query Rigor',
    metric: '<50ms Execution SLA',
    body: 'An AI feature that freezes the client UI or runs uncontrolled N+1 database queries is broken. Background workers, asynchronous queues, and indexed compound lookups are non-negotiable standards.'
  }
];
---

<section id="about" class="py-[var(--space-section-y)] border-t border-[var(--border-subtle)] bg-[var(--bg-surface)] relative" aria-labelledby="about-heading">
  <div class="max-w-[var(--container-max-w)] mx-auto px-[var(--space-gutter)]">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      
      <!-- Left Narrative -->
      <div class="lg:col-span-7 space-y-6">
        <div>
          <div class="flex items-center gap-2 text-[var(--accent)] font-mono text-[var(--text-xs)] uppercase tracking-wider mb-2">
            <span class="w-2 h-2 bg-[var(--accent)] rounded-full shadow-[0_0_8px_var(--accent)]"></span>
            <span class="font-semibold">05 // Engineering Philosophy</span>
          </div>
          <h2 id="about-heading" class="text-[var(--text-xl)] font-serif font-normal tracking-tight text-[var(--text-primary)]">
            How I Think About <span class="gradient-text-solar font-serif italic">Intelligent Systems &amp; Engineering</span>
          </h2>
        </div>

        <div class="space-y-4 text-[var(--text-base)] text-[var(--text-secondary)] leading-relaxed font-sans">
          <p>
            I am a <strong class="text-[var(--text-primary)] font-semibold">Python Developer &amp; AI/ML Engineer</strong> based in Ahmedabad, India. My work focuses on <strong class="text-[var(--text-primary)] font-semibold">custom LLM automation pipelines</strong>, <strong class="text-[var(--text-primary)] font-semibold">scalable enterprise operations architectures</strong>, and <strong class="text-[var(--text-primary)] font-semibold">resilient enterprise backend services</strong>.
          </p>
          <p>
            Rather than treating AI as a shallow API wrapper, I focus on the hard engineering questions: How do we fine-tune a 7B model so it runs locally at zero marginal cost? How do we build a 7-tier failover DAG so a voice-to-order pipeline never drops a customer transaction? How do we seal endpoint DNS loopholes so security cannot be bypassed with a browser toggle?
          </p>
          <p>
            My long-term ambition is to build deep-tech AI software that solves foundational operational bottlenecks. I prioritize empirical evaluation suites, measurable latency SLAs, and clean architectural separation of concerns over superficial trends.
          </p>
        </div>

        <!-- 3 Core Principles Cards with Right-Side Metric Badges -->
        <div class="pt-4 space-y-4 border-t border-[var(--border-subtle)]">
          {PRINCIPLES.map((principle, idx) => (
            <div key={principle.title} class="p-5 border border-[var(--border-subtle)] bg-[var(--bg-app)] rounded-[var(--radius-md)] hover:border-[var(--accent-border)] transition-colors shadow-xs">
              <div class="flex items-center justify-between gap-3 mb-2 pb-1 border-b border-[var(--border-subtle)]/50">
                <div class="font-mono text-[var(--text-xs)] text-[var(--accent)] font-bold flex items-center gap-2">
                  <span>0{idx + 1} //</span>
                  <span>{principle.title}</span>
                </div>
                <span class="font-mono text-[10px] text-[var(--accent)] bg-[var(--bg-surface)] px-2.5 py-0.5 rounded-[var(--radius-sm)] border border-[var(--border-subtle)] font-semibold shrink-0">
                  {principle.metric}
                </span>
              </div>
              <p class="text-[var(--text-xs)] text-[var(--text-secondary)] leading-relaxed font-sans">
                {principle.body}
              </p>
            </div>
          ))}
        </div>

      </div>

      <!-- Right Column: Executive Portrait & Fact Sheet -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- World-Class Executive Portrait Card -->
        <div class="p-6 sm:p-7 border border-[var(--border-subtle)] bg-[var(--bg-app)] rounded-[var(--radius-lg)] space-y-6 shadow-xl relative overflow-hidden group">
          <div class="absolute top-0 left-0 right-0 h-1 bg-[var(--accent-gradient)]"></div>
          
          <!-- Prominent Glowing Circle Portrait -->
          <div class="flex flex-col items-center text-center space-y-4 pt-2">
            <div class="relative">
              <div class="w-40 h-40 sm:w-48 sm:h-48 rounded-full overflow-hidden ring-4 ring-[var(--accent)] ring-offset-4 ring-offset-[var(--bg-app)] shadow-[0_0_40px_var(--accent-glow)] bg-neutral-900 group-hover:scale-105 transition-transform duration-500">
                <img 
                  src="/Portfolio_Website/images/harsh-thanki.png" 
                  alt="Harsh Thanki — Python Developer & AI/ML Engineer" 
                  class="w-full h-full object-cover object-top"
                  width="192"
                  height="192"
                  loading="lazy"
                />
              </div>
              <!-- Online status dot -->
              <span class="absolute bottom-2 right-3 flex h-5 w-5 items-center justify-center rounded-full bg-[var(--bg-app)] ring-2 ring-[var(--bg-app)]">
                <span class="relative flex h-3.5 w-3.5">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--status-complete)] opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-[var(--status-complete)]"></span>
                </span>
              </span>
            </div>

            <div class="space-y-1">
              <div class="text-lg font-bold font-serif text-[var(--text-primary)]">Harsh Thanki</div>
              <div class="text-xs font-mono text-[var(--accent)] font-semibold uppercase tracking-wider">
                Python Developer &middot; AI/ML Engineer
              </div>
              <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-black/40 border border-white/10 text-[11px] font-mono text-[var(--text-secondary)] mt-1">
                <span class="w-2 h-2 rounded-full bg-[var(--status-complete)]"></span>
                <span>Verified Systems Operator</span>
              </div>
            </div>
          </div>

          <!-- Fact Sheet Details -->
          <div class="space-y-3 font-mono text-[var(--text-xs)]">
            <div class="flex items-center justify-between pb-2 border-b border-[var(--border-subtle)] text-[var(--text-primary)] font-bold">
              <span>// EXECUTIVE TELEMETRY</span>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-[var(--accent-subtle)] text-[var(--accent)] border border-[var(--accent-border)] text-[10px]">
                ACTIVE OPERATOR
              </span>
            </div>

            <div class="p-2.5 bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-[var(--radius-sm)]">
              <div class="text-[var(--text-tertiary)] uppercase text-[10px] font-semibold">Location &amp; Timezone</div>
              <div class="text-[var(--text-primary)] font-bold mt-0.5">Ahmedabad, Gujarat, India 🇮🇳 (UTC+5:30)</div>
            </div>

            <div class="p-2.5 bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-[var(--radius-sm)]">
              <div class="text-[var(--text-tertiary)] uppercase text-[10px] font-semibold">Current Focus</div>
              <div class="text-[var(--text-primary)] font-bold mt-0.5">Custom AI Automation, QLoRA &amp; Distributed Backend Pipelines</div>
            </div>

            <div class="p-2.5 bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-[var(--radius-sm)]">
              <div class="text-[var(--text-tertiary)] uppercase text-[10px] font-semibold">Academic Credentials</div>
              <div class="text-[var(--text-primary)] font-bold mt-0.5">MCA (Alliance Univ) &middot; AI/ML Minor (IIT Mandi)</div>
            </div>

            <div class="p-2.5 bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-[var(--radius-sm)]">
              <div class="text-[var(--text-tertiary)] uppercase text-[10px] font-semibold">Primary Core Stack</div>
              <div class="text-[var(--text-primary)] font-bold mt-0.5">Python, PyTorch, FastAPI, Enterprise ERP &amp; ORMs, PostgreSQL, Celery, Redis</div>
            </div>

            <div class="p-2.5 bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-[var(--radius-sm)]">
              <div class="text-[var(--text-tertiary)] uppercase text-[10px] font-semibold">Code Repositories</div>
              <a 
                href="https://github.com/harshthanki-codes" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="text-[var(--accent)] font-bold hover:underline block mt-0.5 truncate"
              >
                github.com/harshthanki-codes &nearr;
              </a>
            </div>
          </div>

          <div class="pt-2 border-t border-[var(--border-subtle)] text-[11px] font-mono text-[var(--text-tertiary)] leading-relaxed">
            Verified production systems operator. Open for technical discussions, high-impact consulting, and strategic engineering contracts.
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
