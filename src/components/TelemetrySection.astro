---
import { TelemetryWidget } from './islands/TelemetryWidget';
---

<section id="telemetry" class="py-[var(--space-section-y)] border-t border-[var(--border-subtle)] bg-[var(--bg-app)] relative" aria-labelledby="telemetry-heading">
  <div class="max-w-[var(--container-max-w)] mx-auto px-[var(--space-gutter)]">
    
    <div class="mb-8">
      <div class="flex items-center gap-2 text-[var(--accent)] font-mono text-[var(--text-xs)] uppercase tracking-wider mb-2">
        <span class="w-2 h-2 bg-[var(--accent)] rounded-full"></span>
        <span>02 // Systems Runtime Proof</span>
      </div>
      <h2 id="telemetry-heading" class="text-[var(--text-xl)] font-serif font-medium tracking-tight text-[var(--text-primary)]">
        Live Backend Telemetry &amp; Health Mesh
      </h2>
      <p class="text-[var(--text-sm)] text-[var(--text-secondary)] mt-1 max-w-2xl font-sans">
        Live operational telemetry across deployed Python backend services, database clusters, and inference execution pipelines.
      </p>
    </div>

    <TelemetryWidget client:visible />

  </div>
</section>
