---
import { TelemetryWidget } from './islands/TelemetryWidget';
import { ArchitectureSimulator } from './islands/ArchitectureSimulator';
---

<section id="telemetry" class="py-[var(--space-section-y)] border-t border-white/[0.08] bg-transparent relative" aria-labelledby="telemetry-heading">
  <div class="max-w-[var(--container-max-w)] mx-auto px-[var(--space-gutter)]">
    
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-8">
      <div>
        <div class="flex items-center gap-2 text-[var(--accent)] font-mono text-[var(--text-xs)] uppercase tracking-wider mb-2">
          <span class="w-2 h-2 bg-[var(--accent)] rounded-full shadow-[0_0_8px_var(--accent)]"></span>
          <span class="font-semibold">03 // Systems Runtime Proof &amp; Chaos Lab</span>
        </div>
        <h2 id="telemetry-heading" class="text-3xl sm:text-4xl lg:text-5xl font-serif font-normal tracking-tight text-[var(--text-primary)]">
          Live Backend Telemetry &amp; <span class="gradient-text-solar font-serif italic">Chaos Simulator</span>
        </h2>
        <p class="text-[var(--text-sm)] sm:text-base text-[var(--text-secondary)] mt-2 max-w-xl font-sans">
          Live operational telemetry across deployed Python backend services, combined with an interactive Chaos Failover Lab and enterprise Token Economics ROI calculator.
        </p>
      </div>

      <!-- Right Side: Real-Time Cluster Diagnostic Badges -->
      <div class="flex flex-wrap items-center gap-2.5 lg:justify-end shrink-0 font-mono">
        <div class="px-3.5 py-2 rounded-xl bg-[#0c0e16]/70 backdrop-blur-xl border border-white/[0.08] shadow-sm">
          <div class="text-[9px] text-[var(--text-tertiary)] uppercase tracking-wider font-semibold">Cluster Topology</div>
          <div class="text-[var(--text-xs)] font-bold text-[var(--text-primary)] flex items-center gap-1.5 mt-0.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--status-complete)] animate-pulse"></span>
            <span>4 Services &middot; 1 DB &middot; Redis Cache</span>
          </div>
        </div>

        <div class="px-3.5 py-2 rounded-xl bg-[#0c0e16]/70 backdrop-blur-xl border border-white/[0.08] shadow-sm">
          <div class="text-[9px] text-[var(--text-tertiary)] uppercase tracking-wider font-semibold">Mesh Latency SLA</div>
          <div class="text-[var(--text-xs)] font-bold text-[var(--text-primary)] flex items-center gap-1.5 mt-0.5">
            <span class="text-[var(--accent)]">24.3ms</span>
            <span class="text-[var(--text-secondary)]">p99 Synthetic Ping</span>
          </div>
        </div>

        <div class="px-3.5 py-2 rounded-xl bg-[#0c0e16]/70 backdrop-blur-xl border border-white/[0.08] shadow-sm">
          <div class="text-[9px] text-[var(--text-tertiary)] uppercase tracking-wider font-semibold">Uptime SLA</div>
          <div class="text-[var(--text-xs)] font-bold text-[var(--status-complete)] flex items-center gap-1.5 mt-0.5">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--status-complete)] opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-[var(--status-complete)]"></span>
            </span>
            <span>99.99% Verified</span>
          </div>
        </div>
      </div>
    </div>

    <div class="space-y-10">
      <TelemetryWidget client:visible />
      <ArchitectureSimulator client:visible />
    </div>

  </div>
</section>
