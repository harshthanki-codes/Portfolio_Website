---
const EXPERIENCES = [
  {
    role: 'Python Developer & AI/ML Engineer',
    company: 'Enterprise AI Systems Lab',
    location: 'Ahmedabad, India',
    period: '2025 – Present',
    status: 'Current Engagement',
    isCurrent: true,
    metric: '35+ Workstations · 8.7/10 LLM Benchmark',
    impact: 'Architecting and deploying enterprise ERP & business automation platforms, on-premise QLoRA fine-tuning pipelines, 7-tier multimodal voice-to-order failover systems, and enterprise DNS proxy watchdogs across 35+ workstations.',
    highlights: [
      'Fine-tuned open-weights 7B models to 8.7/10 score against frontier commercial LLMs on internal ERP benchmarks at $0 marginal cost.',
      'Engineered in-memory multimodal voice-to-order pipeline with zero dropped orders in active production field trials.',
      'Built tamper-proof fails-closed Windows watchdog service closing DoH bypass loopholes across enterprise endpoints.'
    ],
    stack: ['Python', 'Enterprise ERP Systems', 'QLoRA', 'Ollama', 'FastAPI', 'Multimodal Pipelines', 'PostgreSQL', 'Windows Services']
  },
  {
    role: 'Deep Learning & Computer Vision Engineer',
    company: 'Neural Vision Systems',
    location: 'Remote / Hybrid',
    period: 'Jan 2026 – Mar 2026',
    status: 'Completed',
    isCurrent: false,
    metric: 'ResNet & VGG16 · Multi-Class Inference',
    impact: 'Engineered multi-class convolutional neural networks for agricultural plant disease detection using transfer learning architectures.',
    highlights: [
      'Implemented ResNet and VGG16 transfer learning models in TensorFlow with data augmentation pipelines.',
      'Achieved robust classification accuracy across multi-class leaf disease datasets under varying lighting conditions.'
    ],
    stack: ['TensorFlow', 'Python', 'ResNet', 'VGG16', 'OpenCV', 'Transfer Learning']
  },
  {
    role: 'Data Infrastructure & Analytics Engineer',
    company: 'Data Systems Engineering',
    location: 'Remote',
    period: 'Jan 2026 – Feb 2026',
    status: 'Completed',
    isCurrent: false,
    metric: 'Automated Anomaly Detection · Publication Dashboards',
    impact: 'Conducted end-to-end exploratory data analysis and structured data cleaning pipelines for commercial insight reports.',
    highlights: [
      'Automated batch cleaning and anomaly detection for multi-variable business datasets.',
      'Built publication-grade visualization dashboards using Pandas, Matplotlib, and Seaborn.'
    ],
    stack: ['Python', 'Pandas', 'NumPy', 'Matplotlib', 'Seaborn', 'EDA']
  },
  {
    role: 'Minor in Data Science & AI/ML',
    company: 'IIT Mandi (with MCA at Alliance University)',
    location: 'Academic Credential',
    period: '2024 – 2026',
    status: 'Completed with Distinction',
    isCurrent: false,
    metric: 'First-Class Distinction · Deep Neural Architectures',
    impact: 'Completed advanced minor program covering statistical learning theory, deep neural architectures, and applied AI systems.',
    highlights: [
      'Rigorous foundation in gradient descent optimization, transformer attention mechanisms, and model evaluation.',
      'Project-based capstones focusing on practical model deployment and efficiency.'
    ],
    stack: ['Machine Learning', 'Deep Learning', 'PyTorch', 'Linear Algebra', 'Statistical Modeling']
  }
];
---

<section id="experience" class="py-[var(--space-section-y)] border-t border-white/[0.08] bg-transparent relative" aria-labelledby="experience-heading">
  <div class="max-w-[var(--container-max-w)] mx-auto px-[var(--space-gutter)]">
    
    <!-- Section Header with Executive Track Record Telemetry -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12">
      <div>
        <div class="flex items-center gap-2 text-orange-400 font-mono text-xs uppercase tracking-wider mb-2">
          <span class="w-2 h-2 bg-orange-400 rounded-full shadow-[0_0_8px_#ff6600]" />
          <span class="font-semibold">05 // Track Record &amp; Timeline</span>
        </div>
        <h2 id="experience-heading" class="text-3xl sm:text-4xl lg:text-5xl font-serif font-normal tracking-tight text-white">
          Where I've <span class="gradient-text-solar font-serif italic">Delivered Systems</span>
        </h2>
        <p class="text-sm sm:text-base text-gray-400 mt-2 max-w-xl font-sans">
          A verified record of shipping production code, optimizing query layers, and testing AI pipelines under real constraints.
        </p>
      </div>

      <!-- Right Side: Executive Track Record Badges -->
      <div class="flex flex-wrap items-center gap-2.5 lg:justify-end shrink-0 font-mono">
        <div class="px-3.5 py-2 rounded-xl bg-[#0c0e16]/70 backdrop-blur-xl border border-white/[0.08] shadow-sm">
          <div class="text-[9px] text-gray-400 uppercase tracking-wider font-semibold">Active Footprint</div>
          <div class="text-xs font-bold text-white flex items-center gap-1.5 mt-0.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse" />
            <span>35+ Enterprise Workstations</span>
          </div>
        </div>

        <div class="px-3.5 py-2 rounded-xl bg-[#0c0e16]/70 backdrop-blur-xl border border-white/[0.08] shadow-sm">
          <div class="text-[9px] text-gray-400 uppercase tracking-wider font-semibold">Inference Reliability</div>
          <div class="text-xs font-bold text-white flex items-center gap-1.5 mt-0.5">
            <span class="text-orange-400">0%</span>
            <span class="text-gray-300">Dropped Transactions</span>
          </div>
        </div>

        <div class="px-3.5 py-2 rounded-xl bg-[#0c0e16]/70 backdrop-blur-xl border border-white/[0.08] shadow-sm">
          <div class="text-[9px] text-gray-400 uppercase tracking-wider font-semibold">Specialization</div>
          <div class="text-xs font-bold text-white flex items-center gap-1.5 mt-0.5">
            <span class="w-1.5 h-1.5 rounded-full bg-orange-400" />
            <span>Python &middot; AI/ML &middot; ERP</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Timeline List -->
    <div class="space-y-6">
      {EXPERIENCES.map((exp, idx) => (
        <article 
          key={exp.company} 
          class={`p-6 sm:p-8 border rounded-2xl space-y-4 bg-[#0c0e16]/70 backdrop-blur-xl transition-all duration-300 ${
            exp.isCurrent 
              ? 'border-orange-500/40 shadow-[0_12px_36px_rgba(255,102,0,0.12)] ring-1 ring-orange-500/20' 
              : 'border-white/[0.08] hover:border-white/20 hover:bg-[#111420]/80'
          }`}
        >
          
          {/* Header Row */}
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-white/[0.08]">
            <div>
              <span class="font-mono text-[10px] text-orange-400/80 block mb-0.5 font-bold uppercase tracking-wider">
                [0{idx + 1}] &middot; {exp.period}
              </span>
              <h3 class="font-serif font-medium text-lg sm:text-xl text-white">
                {exp.role}
              </h3>
              <div class="text-xs text-orange-400 font-mono font-bold mt-0.5">
                @ {exp.company} <span class="text-gray-400 font-normal">&middot; {exp.location}</span>
              </div>
            </div>

            <div class="flex items-center gap-2 self-start sm:self-center shrink-0">
              <span class="hidden md:inline-flex font-mono text-[10px] text-orange-400 bg-orange-500/10 px-2.5 py-1 rounded-md border border-orange-500/20 font-medium">
                {exp.metric}
              </span>
              <span class={`font-mono text-[10px] uppercase px-3 py-1 rounded-full border font-bold ${
                exp.isCurrent 
                  ? 'bg-orange-500/15 text-orange-400 border-orange-500/30 shadow-[0_0_10px_rgba(255,102,0,0.25)]' 
                  : 'bg-white/[0.04] text-gray-400 border-white/[0.08]'
              }`}>
                {exp.status}
              </span>
            </div>
          </div>

          <p class="text-sm sm:text-base text-gray-300 leading-relaxed font-sans">
            {exp.impact}
          </p>

          {/* Bullet Highlights */}
          <ul class="space-y-2 font-sans text-xs sm:text-sm text-gray-300">
            {exp.highlights.map(item => (
              <li key={item} class="flex items-start gap-2.5">
                <span class="text-orange-400 font-mono font-bold shrink-0">&rarr;</span>
                <span class="leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>

          {/* Stack Chips */}
          <div class="pt-2 flex flex-wrap gap-1.5 font-mono text-[10px]">
            {exp.stack.map(tech => (
              <span key={tech} class="bg-black/40 text-gray-300 px-2.5 py-1 rounded-md border border-white/[0.06]">
                {tech}
              </span>
            ))}
          </div>

        </article>
      ))}
    </div>

  </div>
</section>
