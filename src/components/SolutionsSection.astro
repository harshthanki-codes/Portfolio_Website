---
// World-Class Enterprise Solutions & Capabilities Matrix
// Tailored for Founders, CEOs, CTOs, and Enterprise Clients
---

<section id="solutions" class="py-[var(--space-section-y)] border-t border-[var(--border-subtle)] relative bg-[var(--bg-app)]" aria-labelledby="solutions-heading">
  <div class="max-w-[var(--container-max-w)] mx-auto px-[var(--space-gutter)]">
    
    <!-- Section Header with Executive Telemetry -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-10">
      <div>
        <div class="flex items-center gap-2 text-[var(--accent)] font-mono text-[var(--text-xs)] uppercase tracking-wider mb-2">
          <span class="w-2 h-2 bg-[var(--accent)] rounded-full shadow-[0_0_8px_var(--accent)]"></span>
          <span class="font-semibold">01 // Client Solutions &amp; Capabilities</span>
        </div>
        <h2 id="solutions-heading" class="text-[var(--text-xl)] font-serif font-normal tracking-tight text-[var(--text-primary)]">
          Engineering World-Class <span class="gradient-text-solar font-serif italic">Products, AI &amp; Automations</span>
        </h2>
        <p class="text-[var(--text-sm)] text-[var(--text-secondary)] mt-1.5 max-w-2xl font-sans leading-relaxed">
          We architect custom software solutions tailored strictly to your business requirements. No forced vendor lock-in, zero cloud data-leakage, and verifiable production ROI.
        </p>
      </div>

      <!-- Telemetry Array -->
      <div class="flex flex-wrap items-center gap-2.5 lg:justify-end shrink-0">
        <div class="px-3 py-1.5 rounded-[var(--radius-sm)] bg-[var(--bg-surface-raised)] border border-[var(--border-subtle)] font-mono shadow-xs">
          <div class="text-[9px] text-[var(--text-tertiary)] uppercase tracking-wider font-semibold">Delivery Footprint</div>
          <div class="text-[var(--text-xs)] font-bold text-[var(--text-primary)] flex items-center gap-1.5 mt-0.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--status-complete)]"></span>
            <span>4 Core Solution Disciplines</span>
          </div>
        </div>

        <div class="px-3 py-1.5 rounded-[var(--radius-sm)] bg-[var(--bg-surface-raised)] border border-[var(--border-subtle)] font-mono shadow-xs">
          <div class="text-[9px] text-[var(--text-tertiary)] uppercase tracking-wider font-semibold">Security &amp; Privacy</div>
          <div class="text-[var(--text-xs)] font-bold text-[var(--text-primary)] flex items-center gap-1.5 mt-0.5">
            <span class="text-[var(--accent)] font-bold">100%</span>
            <span class="text-[var(--text-secondary)]">Airgapped / On-Prem Capable</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 4-Pillar Solutions Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      
      <!-- Solution 1: Custom AI & Autonomous LLM Systems -->
      <div class="p-6 sm:p-7 rounded-[var(--radius-lg)] border border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:border-[var(--accent-border)] transition-all shadow-sm hover:shadow-[0_8px_30px_var(--accent-glow)] group flex flex-col justify-between relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1 bg-[var(--accent-gradient)] opacity-80"></div>
        
        <div>
          <div class="flex items-center justify-between gap-3 mb-4">
            <span class="px-2.5 py-0.5 rounded-full font-mono text-[10px] uppercase tracking-wider bg-[var(--accent-subtle)] text-[var(--accent)] border border-[var(--accent-border)] font-bold">
              01 // AI Systems &amp; LLMs
            </span>
            <span class="font-mono text-[10px] text-[var(--status-complete)] font-semibold flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--status-complete)]"></span>
              $0 Marginal Token Cost
            </span>
          </div>

          <h3 class="text-[var(--text-lg)] font-serif font-bold text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors leading-snug">
            Custom AI Solutions &amp; Private LLM Architecture
          </h3>

          <p class="text-[var(--text-sm)] text-[var(--text-secondary)] font-sans mt-2.5 leading-relaxed">
            Eliminate recurring third-party API bills and confidential corporate data leakage. We fine-tune open-weights models (DeepSeek, Qwen, Mistral) on your specific domain data, compiling them into high-speed, local air-gapped runtimes.
          </p>

          <div class="mt-4 pt-4 border-t border-[var(--border-subtle)] space-y-2">
            <div class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-tertiary)] font-bold">
              Core Capabilities Delivered:
            </div>
            <ul class="space-y-1.5 font-mono text-[11px] text-[var(--text-secondary)]">
              <li class="flex items-center gap-2">
                <span class="text-[var(--accent)]">&check;</span>
                <span>Domain-Specific QLoRA 4-bit Quantized Fine-Tuning</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-[var(--accent)]">&check;</span>
                <span>Air-Gapped On-Premise Runtimes (Ollama / vLLM / GGUF)</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-[var(--accent)]">&check;</span>
                <span>Autonomous Agent Tool-Calling (MCP Protocol &amp; APIs)</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-[var(--accent)]">&check;</span>
                <span>Private Enterprise RAG &amp; Vector Search Repositories</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-[var(--border-subtle)] flex items-center justify-between gap-3">
          <div class="font-mono text-[10px] text-[var(--text-tertiary)]">
            Benchmark: <strong class="text-[var(--text-primary)]">8.7/10 Score</strong> vs Claude 3.5
          </div>
          <a 
            href="#scoper" 
            class="inline-flex items-center gap-1.5 font-mono text-[11px] font-bold text-[var(--accent)] hover:underline"
          >
            <span>Scope AI Project &rarr;</span>
          </a>
        </div>
      </div>

      <!-- Solution 2: Intelligent Enterprise Automations & Operations -->
      <div class="p-6 sm:p-7 rounded-[var(--radius-lg)] border border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:border-[var(--accent-border)] transition-all shadow-sm hover:shadow-[0_8px_30px_var(--accent-glow)] group flex flex-col justify-between relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1 bg-[var(--accent-gradient)] opacity-80"></div>
        
        <div>
          <div class="flex items-center justify-between gap-3 mb-4">
            <span class="px-2.5 py-0.5 rounded-full font-mono text-[10px] uppercase tracking-wider bg-[var(--accent-subtle)] text-[var(--accent)] border border-[var(--accent-border)] font-bold">
              02 // Intelligent Automations
            </span>
            <span class="font-mono text-[10px] text-[var(--status-complete)] font-semibold flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--status-complete)]"></span>
              97.6% Error Reduction
            </span>
          </div>

          <h3 class="text-[var(--text-lg)] font-serif font-bold text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors leading-snug">
            Enterprise Automations &amp; Operations Pipelines
          </h3>

          <p class="text-[var(--text-sm)] text-[var(--text-secondary)] font-sans mt-2.5 leading-relaxed">
            Eliminate repetitive operational friction, manual data-entry bottlenecks, and human transcription errors. We engineer autonomous background pipelines connecting phone calls, documents, and external web portals directly to your databases.
          </p>

          <div class="mt-4 pt-4 border-t border-[var(--border-subtle)] space-y-2">
            <div class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-tertiary)] font-bold">
              Core Capabilities Delivered:
            </div>
            <ul class="space-y-1.5 font-mono text-[11px] text-[var(--text-secondary)]">
              <li class="flex items-center gap-2">
                <span class="text-[var(--accent)]">&check;</span>
                <span>Mobile Telephony Call-to-Order Pipeline (Zero Data Loss)</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-[var(--accent)]">&check;</span>
                <span>Automated Legal Scraping &amp; OCR CAPTCHA Decoders</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-[var(--accent)]">&check;</span>
                <span>Indic Multilingual Voice Synthesis &amp; Dubbing Studio</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-[var(--accent)]">&check;</span>
                <span>7-Tier Chaos-Resistant Distributed Failover Mesh</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-[var(--border-subtle)] flex items-center justify-between gap-3">
          <div class="font-mono text-[10px] text-[var(--text-tertiary)]">
            Impact: <strong class="text-[var(--text-primary)]">27 Manual Fixes Saved/Day</strong>
          </div>
          <a 
            href="#scoper" 
            class="inline-flex items-center gap-1.5 font-mono text-[11px] font-bold text-[var(--accent)] hover:underline"
          >
            <span>Scope Automation &rarr;</span>
          </a>
        </div>
      </div>

      <!-- Solution 3: Custom ERP & CRM Platforms -->
      <div class="p-6 sm:p-7 rounded-[var(--radius-lg)] border border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:border-[var(--accent-border)] transition-all shadow-sm hover:shadow-[0_8px_30px_var(--accent-glow)] group flex flex-col justify-between relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1 bg-[var(--accent-gradient)] opacity-80"></div>
        
        <div>
          <div class="flex items-center justify-between gap-3 mb-4">
            <span class="px-2.5 py-0.5 rounded-full font-mono text-[10px] uppercase tracking-wider bg-[var(--accent-subtle)] text-[var(--accent)] border border-[var(--accent-border)] font-bold">
              03 // Enterprise ERP &amp; CRM
            </span>
            <span class="font-mono text-[10px] text-[var(--status-complete)] font-semibold flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--status-complete)]"></span>
              85% Catalog Speedup
            </span>
          </div>

          <h3 class="text-[var(--text-lg)] font-serif font-bold text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors leading-snug">
            Custom ERP &amp; CRM Architecture &amp; Integration
          </h3>

          <p class="text-[var(--text-sm)] text-[var(--text-secondary)] font-sans mt-2.5 leading-relaxed">
            Software built strictly around how your business operates—not the other way around. We engineer high-throughput inventory engines, custom modules, ledger architectures, and seamless bi-directional ERP integrations.
          </p>

          <div class="mt-4 pt-4 border-t border-[var(--border-subtle)] space-y-2">
            <div class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-tertiary)] font-bold">
              Core Capabilities Delivered:
            </div>
            <ul class="space-y-1.5 font-mono text-[11px] text-[var(--text-secondary)]">
              <li class="flex items-center gap-2">
                <span class="text-[var(--accent)]">&check;</span>
                <span>Odoo 18/19 &amp; ERPNext / Frappe Custom Business Logic</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-[var(--accent)]">&check;</span>
                <span>Dynamic-Schema Bulk-Import Pipeline (10K+ SKUs/batch)</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-[var(--accent)]">&check;</span>
                <span>High-Throughput Multi-Currency Relational Ledgers</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-[var(--accent)]">&check;</span>
                <span>AI Conversational Quotation &amp; Price-Anomaly Guardrails</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-[var(--border-subtle)] flex items-center justify-between gap-3">
          <div class="font-mono text-[10px] text-[var(--text-tertiary)]">
            Scale: <strong class="text-[var(--text-primary)]">32,000+ SKU Catalog</strong> Handling
          </div>
          <a 
            href="#scoper" 
            class="inline-flex items-center gap-1.5 font-mono text-[11px] font-bold text-[var(--accent)] hover:underline"
          >
            <span>Scope ERP System &rarr;</span>
          </a>
        </div>
      </div>

      <!-- Solution 4: Full-Stack Products & Resilient Backends -->
      <div class="p-6 sm:p-7 rounded-[var(--radius-lg)] border border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:border-[var(--accent-border)] transition-all shadow-sm hover:shadow-[0_8px_30px_var(--accent-glow)] group flex flex-col justify-between relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1 bg-[var(--accent-gradient)] opacity-80"></div>
        
        <div>
          <div class="flex items-center justify-between gap-3 mb-4">
            <span class="px-2.5 py-0.5 rounded-full font-mono text-[10px] uppercase tracking-wider bg-[var(--accent-subtle)] text-[var(--accent)] border border-[var(--accent-border)] font-bold">
              04 // Products &amp; Scalable Backends
            </span>
            <span class="font-mono text-[10px] text-[var(--status-complete)] font-semibold flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--status-complete)]"></span>
              &lt;50ms Response SLA
            </span>
          </div>

          <h3 class="text-[var(--text-lg)] font-serif font-bold text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors leading-snug">
            Full-Stack Web, Mobile &amp; High-Throughput APIs
          </h3>

          <p class="text-[var(--text-sm)] text-[var(--text-secondary)] font-sans mt-2.5 leading-relaxed">
            From consumer-facing web platforms to sub-second API microservices and secure endpoint daemons. We build production-ready software systems with strict test coverage, typed schemas, and zero unhandled failure states.
          </p>

          <div class="mt-4 pt-4 border-t border-[var(--border-subtle)] space-y-2">
            <div class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-tertiary)] font-bold">
              Core Capabilities Delivered:
            </div>
            <ul class="space-y-1.5 font-mono text-[11px] text-[var(--text-secondary)]">
              <li class="flex items-center gap-2">
                <span class="text-[var(--accent)]">&check;</span>
                <span>FastAPI Asynchronous Microservices &amp; Streaming APIs</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-[var(--accent)]">&check;</span>
                <span>Astro + React High-Performance Reactive Web Dashboards</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-[var(--accent)]">&check;</span>
                <span>Cross-Platform Flutter &amp; Native Android Telephony Bridges</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-[var(--accent)]">&check;</span>
                <span>Tamper-Proof Windows Endpoint Watchdog &amp; DNS Proxy</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-[var(--border-subtle)] flex items-center justify-between gap-3">
          <div class="font-mono text-[10px] text-[var(--text-tertiary)]">
            Concurrency: <strong class="text-[var(--text-primary)]">50+ Req/s</strong> Load-Tested
          </div>
          <a 
            href="#scoper" 
            class="inline-flex items-center gap-1.5 font-mono text-[11px] font-bold text-[var(--accent)] hover:underline"
          >
            <span>Scope Full-Stack &rarr;</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Client Advisory Banner -->
    <div class="mt-10 p-5 sm:p-6 rounded-[var(--radius-lg)] border border-[var(--border-subtle)] bg-[var(--bg-surface-raised)] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 font-mono text-[var(--text-xs)]">
      <div class="space-y-1">
        <div class="font-bold text-[var(--text-primary)] flex items-center gap-2">
          <span class="text-[var(--accent)]">&diams;</span>
          <span>Have a custom technical challenge or business bottleneck?</span>
        </div>
        <p class="text-[var(--text-secondary)] font-sans text-[13px]">
          We diagnose the exact constraint, architect the data topology, and deliver production-grade software backed by measurable SLAs.
        </p>
      </div>

      <a 
        href="#scoper" 
        class="touch-target px-5 py-2.5 rounded-[var(--radius-md)] bg-[var(--accent-gradient)] text-[var(--accent-text)] font-bold shadow-[0_4px_16px_var(--accent-glow)] hover:shadow-[0_8px_24px_var(--accent-glow)] transition-all shrink-0"
      >
        Configure Project Scope &rarr;
      </a>
    </div>

  </div>
</section>
