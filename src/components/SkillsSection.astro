---
const SKILL_PILLARS = [
  {
    category: 'Applied AI & LLM Systems',
    tag: 'Core Intelligence',
    description: 'On-premise open-weights fine-tuning, multi-model failover orchestration, and speech synthesis pipelines.',
    skills: [
      { name: 'QLoRA / PEFT', desc: '4-bit quant fine-tuning', highlight: true },
      { name: 'Unsloth & Transformers', desc: 'High-throughput LLM training', highlight: false },
      { name: 'Ollama Airgapped Runtime', desc: 'Local zero-cost inference', highlight: true },
      { name: 'Multimodal Audio Ingestion', desc: 'Gemini 1.5, NVIDIA NIM', highlight: false },
      { name: 'Speech Synthesis (F5 / VibeVoice)', desc: 'Zero-shot voice cloning', highlight: true },
      { name: 'Empirical Benchmark Suites', desc: 'Internal test suites & WER', highlight: false }
    ]
  },
  {
    category: 'Backend & Enterprise Architecture',
    tag: 'Systems Layer',
    description: 'Scalable service layers, ERP module architecture, and asynchronous execution queues.',
    skills: [
      { name: 'Python (FastAPI / Flask)', desc: 'High-concurrency REST APIs', highlight: true },
      { name: 'Node.js & Express (TypeScript)', desc: 'MERN microservice design', highlight: true },
      { name: 'Odoo 17/19 ORM & QWeb', desc: 'Custom enterprise business logic', highlight: true },
      { name: 'Asynchronous Job Queues', desc: 'Odoo queue_job & workers', highlight: false },
      { name: 'Financial & FX Engines', desc: 'Multi-currency computed rollups', highlight: false },
      { name: 'Proxy Routing Bridges', desc: 'Local CLI AI routing layers', highlight: false }
    ]
  },
  {
    category: 'Data & Database Optimization',
    tag: 'Persistence & Scale',
    description: 'High-integrity transaction ledgers, relational indexing, and document databases.',
    skills: [
      { name: 'PostgreSQL', desc: 'Compound indexing & N+1 query fixes', highlight: true },
      { name: 'MongoDB Atlas', desc: 'Document modeling & aggregation', highlight: true },
      { name: 'In-Memory Caching', desc: 'FX rates, tokens & state buffers', highlight: false },
      { name: 'Pandas & NumPy', desc: 'Data wrangling & batch ingestion', highlight: false },
      { name: 'Data Pipeline Security', desc: 'HMAC-SHA256 authenticated streams', highlight: false }
    ]
  },
  {
    category: 'Systems, Security & Automation',
    tag: 'Infrastructure',
    description: 'Low-level network controls, browser extensions, and serverless automation meshes.',
    skills: [
      { name: 'Windows Services & Watchdogs', desc: 'Fails-closed security daemons', highlight: true },
      { name: 'Custom DNS Proxies', desc: 'DoH stripping & site whitelisting', highlight: true },
      { name: 'Chrome Extensions (Manifest V3)', desc: 'Zero-click background capture', highlight: false },
      { name: 'Google Apps Script & Drive API', desc: 'Serverless enterprise pipelines', highlight: false },
      { name: 'Docker & Linux Operations', desc: 'Containerization & cloud hosting', highlight: false },
      { name: 'Git & GitHub CI/CD', desc: 'Automated test & deploy pipelines', highlight: false }
    ]
  }
];
---

<section id="skills" class="py-[var(--space-section-y)] border-t border-[var(--border-subtle)] bg-[var(--bg-surface)] relative" aria-labelledby="skills-heading">
  <div class="max-w-[var(--container-max-w)] mx-auto px-[var(--space-gutter)]">
    
    <!-- Section Header -->
    <div class="mb-10">
      <div class="flex items-center gap-2 text-[var(--accent)] font-mono text-[var(--text-xs)] uppercase tracking-wider mb-2">
        <span class="w-2 h-2 bg-[var(--accent)] rounded-full shadow-[0_0_8px_var(--accent)]"></span>
        <span class="font-semibold">03 // Technical Matrix</span>
      </div>
      <h2 id="skills-heading" class="text-[var(--text-xl)] font-serif font-normal tracking-tight text-[var(--text-primary)]">
        Engineering Capabilities &amp; <span class="gradient-text-solar font-serif italic">Tech Stack</span>
      </h2>
      <p class="text-[var(--text-sm)] text-[var(--text-secondary)] mt-1.5 max-w-2xl font-sans">
        Every tool, framework, and model listed below has been deployed in real production code or active field trials.
      </p>
    </div>

    <!-- 4-Pillar Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {SKILL_PILLARS.map((pillar, idx) => (
        <div key={pillar.category} class="p-6 sm:p-7 border border-[var(--border-subtle)] bg-[var(--bg-app)] rounded-[var(--radius-lg)] space-y-5 shadow-xs hover:border-[var(--accent-border)] transition-all">
          
          <div class="flex items-center justify-between pb-3 border-b border-[var(--border-subtle)]">
            <div>
              <span class="font-mono text-[10px] text-[var(--accent)] font-semibold uppercase tracking-wider block mb-0.5">
                {pillar.tag}
              </span>
              <h3 class="font-serif font-medium text-[var(--text-base)] text-[var(--text-primary)]">
                {pillar.category}
              </h3>
            </div>
            <span class="font-mono text-[11px] text-[var(--text-tertiary)] bg-[var(--bg-surface)] px-2.5 py-1 rounded-[var(--radius-sm)] border border-[var(--border-subtle)] font-bold">
              0{idx + 1}
            </span>
          </div>

          <p class="text-[var(--text-xs)] text-[var(--text-secondary)] leading-relaxed font-sans">
            {pillar.description}
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1">
            {pillar.skills.map(skill => (
              <div 
                key={skill.name} 
                class={`p-3 bg-[var(--bg-surface)] border rounded-[var(--radius-sm)] transition-all ${
                  skill.highlight 
                    ? 'border-[var(--accent-border)] shadow-xs' 
                    : 'border-[var(--border-subtle)] hover:border-[var(--border-strong)]'
                }`}
              >
                <div class="font-mono text-[var(--text-xs)] font-bold text-[var(--text-primary)] flex items-center justify-between">
                  <span>{skill.name}</span>
                  {skill.highlight && <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>}
                </div>
                <div class="text-[10px] text-[var(--text-tertiary)] mt-0.5 font-sans">
                  {skill.desc}
                </div>
              </div>
            ))}
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
