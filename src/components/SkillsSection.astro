---
const SKILL_PILLARS = [
  {
    category: 'Applied AI & LLM Systems',
    tag: 'Core Intelligence',
    metric: '8.7/10 Eval Score · $0 Marginal Cost',
    topology: 'Raw Corpora ➔ QLoRA 4-bit Quant ➔ Ollama Local Runtime ➔ Transparent Proxy Bridge',
    description: 'On-premise open-weights fine-tuning, multi-model failover orchestration, and neural speech synthesis pipelines.',
    skills: [
      { name: 'QLoRA / PEFT', desc: '4-bit quant fine-tuning', highlight: true },
      { name: 'Unsloth & Transformers', desc: 'High-throughput LLM training', highlight: false },
      { name: 'Ollama Airgapped Runtime', desc: 'Local zero-cost inference', highlight: true },
      { name: 'Multimodal Audio Ingestion', desc: 'Acoustic streaming & speech DAGs', highlight: false },
      { name: 'Neural Speech Synthesis', desc: 'Zero-shot voice cloning & studio TTS', highlight: true },
      { name: 'Empirical Benchmark Suites', desc: 'Internal test suites & WER', highlight: false }
    ]
  },
  {
    category: 'Backend & Enterprise Architecture',
    tag: 'Systems Layer',
    metric: 'Zero Sync Locks · 100% Async Queues',
    topology: 'FastAPI Service ➔ Celery Worker Pool ➔ Redis State Buffer ➔ ACID Database Rollup',
    description: 'Scalable service layers, enterprise module architecture, and distributed asynchronous execution queues.',
    skills: [
      { name: 'Python (FastAPI / Flask)', desc: 'High-concurrency REST APIs', highlight: true },
      { name: 'Distributed Task Workers', desc: 'Celery, Redis & async worker pools', highlight: true },
      { name: 'Enterprise ORM & Business Logic', desc: 'Complex relational domain engines', highlight: true },
      { name: 'Asynchronous Job Queues', desc: 'Distributed workers & task queues', highlight: false },
      { name: 'Financial & FX Engines', desc: 'Multi-currency computed rollups', highlight: false },
      { name: 'Proxy Routing Bridges', desc: 'Local CLI AI routing layers', highlight: false }
    ]
  },
  {
    category: 'Data & Database Optimization',
    tag: 'Persistence & Scale',
    metric: '<50ms Query SLA · Zero N+1 Cascades',
    topology: 'Normalized Relational Schema ➔ Compound Indexing ➔ In-Memory Cache ➔ Real-Time Ledger',
    description: 'High-integrity transaction ledgers, relational compound indexing, and distributed document databases.',
    skills: [
      { name: 'PostgreSQL', desc: 'Compound indexing & N+1 query fixes', highlight: true },
      { name: 'MongoDB Atlas', desc: 'Document modeling & aggregation', highlight: true },
      { name: 'In-Memory Caching', desc: 'FX rates, tokens & state buffers', highlight: false },
      { name: 'Pandas & NumPy', desc: 'Data wrangling & batch ingestion', highlight: false },
      { name: 'Data Pipeline Security', desc: 'HMAC-SHA256 authenticated streams', highlight: false }
    ]
  },
  {
    category: 'Systems, Security & Automation',
    tag: 'Infrastructure',
    metric: 'Fails-Closed Daemon · 35+ Endpoints',
    topology: 'OS Service Loop ➔ Tamper-Proof Watchdog ➔ DNS Whitelist Filter ➔ Encrypted Telemetry',
    description: 'Low-level network controls, browser extensions, and resilient serverless automation meshes.',
    skills: [
      { name: 'Windows Services & Watchdogs', desc: 'Fails-closed security daemons', highlight: true },
      { name: 'Custom DNS Proxies', desc: 'DoH stripping & site whitelisting', highlight: true },
      { name: 'Chrome Extensions (Manifest V3)', desc: 'Zero-click background capture', highlight: false },
      { name: 'Google Apps Script & Drive API', desc: 'Serverless enterprise pipelines', highlight: false },
      { name: 'Docker & Linux Operations', desc: 'Containerization & cloud hosting', highlight: false },
      { name: 'Git & GitHub CI/CD', desc: 'Automated test & deploy pipelines', highlight: false }
    ]
  }
];
---

<section id="skills" class="py-[var(--space-section-y)] border-t border-white/[0.08] bg-transparent relative" aria-labelledby="skills-heading">
  <div class="max-w-[var(--container-max-w)] mx-auto px-[var(--space-gutter)]">
    
    <!-- Section Header with Executive Telemetry Hub -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12">
      <div>
        <div class="flex items-center gap-2 text-orange-400 font-mono text-xs uppercase tracking-wider mb-2">
          <span class="w-2 h-2 bg-orange-400 rounded-full shadow-[0_0_8px_#ff6600]" />
          <span class="font-semibold">04 // Technical Matrix</span>
        </div>
        <h2 id="skills-heading" class="text-3xl sm:text-4xl lg:text-5xl font-serif font-normal tracking-tight text-white">
          Engineering Capabilities &amp; <span class="gradient-text-solar font-serif italic">Tech Stack</span>
        </h2>
        <p class="text-sm sm:text-base text-gray-400 mt-2 max-w-xl font-sans">
          Every tool, framework, and model listed below has been deployed in real production code or active field trials.
        </p>
      </div>

      <!-- Right Side: Executive Capability Telemetry Array -->
      <div class="flex flex-wrap items-center gap-2.5 lg:justify-end shrink-0 font-mono">
        <div class="px-3.5 py-2 rounded-xl bg-[#0c0e16]/70 backdrop-blur-xl border border-white/[0.08] shadow-sm">
          <div class="text-[9px] text-gray-400 uppercase tracking-wider font-semibold">Verified Stack</div>
          <div class="text-xs font-bold text-white flex items-center gap-1.5 mt-0.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse" />
            <span>24 Production Technologies</span>
          </div>
        </div>

        <div class="px-3.5 py-2 rounded-xl bg-[#0c0e16]/70 backdrop-blur-xl border border-white/[0.08] shadow-sm">
          <div class="text-[9px] text-gray-400 uppercase tracking-wider font-semibold">Deployment Footprint</div>
          <div class="text-xs font-bold text-white flex items-center gap-1.5 mt-0.5">
            <span class="w-1.5 h-1.5 rounded-full bg-orange-400" />
            <span>Airgapped &amp; On-Premise Capable</span>
          </div>
        </div>

        <div class="px-3.5 py-2 rounded-xl bg-[#0c0e16]/70 backdrop-blur-xl border border-white/[0.08] shadow-sm">
          <div class="text-[9px] text-gray-400 uppercase tracking-wider font-semibold">Execution Latency</div>
          <div class="text-xs font-bold text-white flex items-center gap-1.5 mt-0.5">
            <span class="text-orange-400">&lt;50ms</span>
            <span class="text-gray-300">Relational ORM Rollups</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 4-Pillar Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {SKILL_PILLARS.map((pillar, idx) => (
        <div key={pillar.category} class="p-6 sm:p-7 border border-white/[0.08] bg-[#0c0e16]/70 backdrop-blur-xl rounded-2xl space-y-4 shadow-md hover:border-orange-500/40 hover:bg-[#111420]/80 transition-all duration-300 flex flex-col justify-between group">
          
          <div class="space-y-3">
            <div class="flex items-start justify-between gap-3 pb-3 border-b border-white/[0.08]">
              <div>
                <span class="font-mono text-[10px] text-orange-400 font-semibold uppercase tracking-wider block mb-0.5">
                  {pillar.tag}
                </span>
                <h3 class="font-serif font-medium text-lg text-white group-hover:text-orange-400 transition-colors">
                  {pillar.category}
                </h3>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class="hidden sm:inline-flex px-2.5 py-1 rounded-full bg-orange-500/10 border border-orange-500/20 text-[10px] font-mono text-orange-400 font-semibold">
                  {pillar.metric}
                </span>
                <span class="font-mono text-xs text-gray-400 bg-white/[0.04] px-2.5 py-1 rounded-lg border border-white/[0.06] font-bold">
                  0{idx + 1}
                </span>
              </div>
            </div>

            <p class="text-xs sm:text-sm text-gray-300 leading-relaxed font-sans">
              {pillar.description}
            </p>

            <!-- Architecture Topology Pipeline Bar -->
            <div class="px-3.5 py-2.5 bg-black/40 border border-white/[0.06] rounded-xl flex items-center gap-2 text-[10px] font-mono text-gray-400 overflow-x-auto no-scrollbar whitespace-nowrap">
              <span class="text-orange-400 font-bold shrink-0">PIPELINE //</span>
              <span class="text-gray-200 font-medium">
                {pillar.topology}
              </span>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2">
            {pillar.skills.map(skill => (
              <div 
                key={skill.name} 
                class={`p-3 bg-black/40 border rounded-xl transition-all duration-200 ${
                  skill.highlight 
                    ? 'border-orange-500/30 bg-orange-500/[0.04] shadow-xs' 
                    : 'border-white/[0.06] hover:border-white/20'
                }`}
              >
                <div class="font-mono text-xs font-bold text-white flex items-center justify-between">
                  <span>{skill.name}</span>
                  {skill.highlight && <span class="w-1.5 h-1.5 rounded-full bg-orange-400 shadow-[0_0_6px_#ff6600]" />}
                </div>
                <div class="text-[10px] text-gray-400 mt-1 font-sans">
                  {skill.desc}
                </div>
              </div>
            ))}
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
